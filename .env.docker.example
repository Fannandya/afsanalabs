# Contoh env produksi. Salin ke `.env.docker`, isi semua CHANGEME.
# Di Dokploy: isi nilai yang sama via menu Environment (tanpa file).
APP_NAME=Afsana
APP_URL=https://domain-anda
FRONTEND_URL=https://domain-anda
SANCTUM_STATEFUL_DOMAINS=domain-anda
APP_KEY=
DB_DATABASE=jasa_website
DB_USERNAME=jasa
DB_PASSWORD=CHANGEME
MYSQL_ROOT_PASSWORD=CHANGEME
SESSION_LIFETIME=120
SEED_ADMIN_EMAIL=admin@lima.ai
SEED_ADMIN_PASSWORD=CHANGEMEKUAT
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=halo@domain-anda
TUNNEL_TOKEN=
# Kosongkan = frontend + API satu domain (disarankan untuk Dokploy).
VITE_API_BASE=
